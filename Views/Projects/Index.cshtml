@model Al_Shami_AISS_.ViewModels.ProjectListViewModel

@{
    ViewData["Title"] = "Projects";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">مشاريعنا</h1>
            <p class="text-muted">نظرة على الحلول والمرافق التي قدمتها S H G.</p>
        </div>

        <div class="row g-4">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                        {
                            <img src="@project.ImageUrl" class="card-img-top" alt="@project.Title" style="height: 220px; object-fit: cover;" />
                        }
                        <div class="card-body">
                            <h3 class="h5">@project.Title</h3>
                            <p class="text-muted mb-2">@project.ClientName</p>
                            <p class="mb-3">@project.Location</p>
                            <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-primary">رؤوية التفاصيل</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
