@model Al_Shami_AISS_.ViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Title" />
                }
                else
                {
                    <div class="bg-light rounded shadow-sm d-flex align-items-center justify-content-center" style="height: 420px;">
                        <span class="text-muted">No project image available</span>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <h1 class="fw-bold mb-3">@Model.Title</h1>
                <p class="text-muted mb-2"><strong>Client:</strong> @Model.ClientName</p>
                <p class="text-muted mb-2"><strong>Location:</strong> @Model.Location</p>
                <p class="text-muted mb-2"><strong>Completion Date:</strong> @(Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("MMM dd, yyyy") : "Not specified")</p>
                <p class="text-muted mb-3"><strong>Featured:</strong> @(Model.IsFeatured ? "Yes" : "No")</p>

                <p class="lead">@Model.Description</p>

                <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-secondary">العودة إلى قائمة المشاريع</a>
            </div>
        </div>

        @if (Model.GalleryImages.Any())
        {
            <div class="mt-5">
                <h3 class="fw-bold mb-4">معرض المشروع</h3>
                <div class="row g-4">
                    @foreach (var imageUrl in Model.GalleryImages)
                    {
                        <div class="col-md-4 col-lg-3">
                            <img src="@imageUrl" class="img-fluid rounded shadow-sm w-100" alt="@Model.Title gallery image" style="height: 220px; object-fit: cover;" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
