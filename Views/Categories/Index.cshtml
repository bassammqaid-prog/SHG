@model List<Al_Shami_ِAISS_.Models.Category>

@{
    ViewData["Title"] = "الفئات";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">الفئات</h1>
            <p class="text-muted">تصفح مجموعات منتجاتنا بحسب النوع والخدمة.</p>
        </div>

        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h2 class="h5 fw-bold">@category.Name</h2>
                            <p class="text-muted">@category.Description</p>
                            <a asp-controller="Categories" asp-action="Details" asp-route-slug="@category.Slug" class="btn btn-primary">عرض التفاصيل</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
