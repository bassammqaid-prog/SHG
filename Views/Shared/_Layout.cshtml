@using System.Globalization
@using Al_Shami_AISS_.Resources
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> Localizer


@{
    var requestCulture = HttpContextAccessor.HttpContext?.Features.Get<IRequestCultureFeature>()?.RequestCulture;
    var currentCulture = requestCulture?.Culture ?? CultureInfo.CurrentCulture;
    var isRtl = currentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var currentCultureName = currentCulture.Name;

    var returnUrl =
        Context.Request.Path +
        Context.Request.QueryString;
}


<!DOCTYPE html>
<html lang="@currentCultureName" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoMeta")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light @(isRtl ? "rtl-body" : "ltr-body")">
    <div style="background:red;color:white;padding:10px;font-weight:bold">
        Culture = @System.Globalization.CultureInfo.CurrentUICulture.Name
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">S H G</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        @* فحص ما إذا كان المستخدم في الواجهة العامة (خارج أي Area) *@
                        @if (ViewContext.RouteData.Values["area"] == null || string.IsNullOrEmpty(ViewContext.RouteData.Values["area"]?.ToString()))
                        {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">@Localizer["الرئيسية"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">@Localizer["حول الشركة"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">@Localizer["المنتجات"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">@Localizer["المشاريع"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">@Localizer["اتصل بنا"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quote" ? "active" : "")" asp-controller="Quote" asp-action="Index">@Localizer["طلب عرض سعر"]</a>
                        </li>
                        }
                        @if (User.Identity is not null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["لوحة التحكم"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">@Localizer["الفئات"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">@Localizer["المنتجات"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Projects" asp-action="Index">@Localizer["المشاريع"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">@Localizer["الرسائل"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="QuoteRequests" asp-action="Index">@Localizer["عروض الأسعار"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="ActivityLogs" asp-action="Index">@Localizer["سجلات النشاط "]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">@Localizer["التقارير"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="ProductImages" asp-action="Index">@Localizer["صور المنتجات"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="ProjectImages" asp-action="Index">@Localizer["صور المشاريع"]</a>
                                </li>
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["لوحة التحكم"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">@Localizer["المنتجات"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Projects" asp-action="Index">@Localizer["المشاريع"]</a>
                                </li>
                            }

                            <li class="nav-item ms-lg-3">
                                <form asp-area="Account" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">@Localizer["تسجيل الخروج"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-light btn-sm"asp-area="" asp-controller="Account" asp-action="Login">@Localizer["تسجيل الدخول"]</a>
                            </li>
                        }
                        
                        <li class="nav-item ms-lg-3 dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@currentCulture.NativeName</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-culture="ar-YE" asp-route-returnUrl="@returnUrl">العربية</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">English</a></li>
                            </ul>
                        </li>



                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5 pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold">S H G</h5>
                    <p class="text-secondary">@Localizer["مقدمة الشركة"]</p>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">@Localizer["روابط سريعة"]</h5>
                    <ul class="list-unstyled">
                        <li><a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">@Localizer["الرئيسية"]</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-controller="Home" asp-action="About">@Localizer["حول موقعنا"]</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-controller="Products" asp-action="Index">@Localizer["المنتجات"]</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-controller="Projects" asp-action="Index">@Localizer["المشاريع"]</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">@Localizer["للتواصل"]</h5>
                    <p class="text-secondary mb-1">Email: info@shg.com</p>
                    <p class="text-secondary mb-1">Phone: +966 773297111</p>
                    <p class="text-secondary mb-0">Location: Sana'a, Yemen</p>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-secondary small">
                &copy; 2026 AISS. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
