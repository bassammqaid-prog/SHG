@{
    ViewData["Title"] = "About Us";
}

@* The About page explains the company story and helps visitors understand the business values behind the brand. *@
@* The page uses static marketing content and is intentionally simple to keep it readable and easy to maintain. *@

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-3 py-2">About AISS</span>
            <h1 class="display-5 fw-bold mt-3">Building Better Operations Through Trusted Solutions</h1>
        </div>

        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <p class="lead">Al-Shami Integrated Solutions &amp; Supply (AISS) is a professional supply and project partner serving clients across industrial, commercial, and energy-driven sectors.</p>
                <p class="text-muted">We support our customers by delivering dependable products, technical insight, and disciplined execution across every stage of a project lifecycle.</p>
            </div>
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h3 class="h5">Our Vision</h3>
                        <p class="mb-0">To become the preferred industrial and supply partner for organizations that value performance, trust, and long-term results.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Mission</h3>
                        <p class="text-muted mb-0">To deliver safe, reliable, and innovative supply solutions that enable sustainable operational excellence.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Core Values</h3>
                        <p class="text-muted mb-0">Integrity, accountability, quality, and long-term customer trust.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Industries Served</h3>
                        <p class="text-muted mb-0">Commercial projects, industrial works, utility infrastructure, and energy applications.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Operational Focus</h3>
                        <p class="text-muted mb-0">Provision of mission-critical systems, equipment, and technical support packages.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Sector Expertise</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Energy Solutions</h3>
                        <p class="text-muted mb-0">Supply and system support for energy generation, transmission, and efficiency programs.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Safety Solutions</h3>
                        <p class="text-muted mb-0">Detection, protection, and compliance systems designed to reduce operational risk.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Oil &amp; Gas</h3>
                        <p class="text-muted mb-0">Reliable equipment and support for upstream, midstream, and downstream operations.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Industrial Equipment</h3>
                        <p class="text-muted mb-0">Operational tools and infrastructure items built for demanding work environments.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Partner with AISS</h2>
        <p class="lead text-light-emphasis">We are ready to support your next project with practical, reliable, and scalable solutions.</p>
        <a asp-controller="Quote" asp-action="Index" class="btn btn-light btn-lg mt-3">Request a Quote</a>
    </div>
</section>
