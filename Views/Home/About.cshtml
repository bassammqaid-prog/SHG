@{
    ViewData["Title"] = "About Us";
}

@* The About page explains the company story and helps visitors understand the business values behind the brand. *@
@* The page uses static marketing content and is intentionally simple to keep it readable and easy to maintain. *@

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-3 py-2">عننا S H G</span>
            <h1 class="display-5 fw-bold mt-3">بناء عمليات أفضل من خلال حلول موثوقة</h1>
        </div>

        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <p class="lead">شركة الشامي للحلول المتكاملة والتوريدات (S H G) هي شريك احترافي في مجالات التوريد والمشاريع، تخدم العملاء عبر القطاعات الصناعية والتجارية وقطاعات الطاقة</p>
                <p class="text-muted">
                    نحن ندعم عملاءنا من خلال تقديم منتجات موثوقة، ورؤى تقنية، وتنفيذ منضبط عبر جميع مراحل دورة حياة المشروع
        
                </p>
            </div>
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h3 class="h5">رؤيتنا</h3>
                        <p class="mb-0">
                            أن نكون شريك التوريد والشريك الصناعي المفضل للمؤسسات التي تقدر الأداء العالي، والثقة، والنتائج طويلة الأجل
                            
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">رسالتنا</h3>
                        <p class="text-muted mb-0">
                            تقديم حلول توريد آمنة، وموثوقة، ومبتكرة تتيح تحقيق التميز التشغيلي المستدام.
                            
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">القيم الجوهرية</h3>
                        <p class="text-muted mb-0">
                            النزاهة، والمسؤولية، والجودة، وثقة العملاء طويلة الأجل
                           
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">القطاعات المستهدفة</h3>
                        <p class="text-muted mb-0">
                            المشاريع التجارية، والأعمال الصناعية، والبنية التحتية للمرافق، وتطبيقات الطاقة.
                            
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">التركيز التشغيلي</h3>
                        <p class="text-muted mb-0">
                            توفير الأنظمة والمعدات الحيوية للمشاريع، وحزم الدعم الفني.
                         (مثل المعدات الكهربائية أو الميكانيكية وأنظمة الطاقة الشمسية)，
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">القطاعات المتخصصة</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">حلول الطاقة</h3>
                        <p class="text-muted mb-0">
                            التوريد ودعم الأنظمة لبرامج توليد الطاقة، ونقلها، وكفاءة استهلاكها
                                    .
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">حلول الامان</h3>
                        <p class="text-muted mb-0">أنظمة الكشف ، والحماية، والامتثال المصممة للحد من المخاطر التشغيلية او الحرائق</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">النفط والغاز</h3>
                        <p class="text-muted mb-0">معدات موثوقة ودعم متكامل لعمليات الإنتاج والتكرير والتوزيع وقطع الغيار والصيانة ( صناعات النفط والغاز بالمنبع والمصب والمرحلة الوسطى والبيع)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">معدات الصناعة</h3>
                        <p class="text-muted mb-0">الأدوات التشغيلية وعناصر البنية التحتية المصممة لبيئات العمل الشاقة</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">لتكن شريك مع S H G</h2>
        <p class="lead text-light-emphasis">نحن على أتم الاستعداد لدعم مشروعكم القادم بحلول عملية، وموثوقة، وقابلة للتطوير</p>
        <a asp-controller="Quote" asp-action="Index" class="btn btn-light btn-lg mt-3">طلب عرض سعر</a>
    </div>
</section>
