@model Al_Shami_AISS_.Areas.Admin.ViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">تفاصيل المشروع</h1>
            <p class="text-muted mb-0">مراجعة المشروع المحدد.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="ProjectImages" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-outline-primary me-2">إدارة المعرض</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">العودة إلى القائمة</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-fluid rounded border" alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 220px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Client</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ClientName) ? "-" : Model.ClientName)</dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Location) ? "-" : Model.Location)</dd>

                        <dt class="col-sm-4">Completion Date</dt>
                        <dd class="col-sm-8">@(Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("yyyy-MM-dd") : "-")</dd>

                        <dt class="col-sm-4">Featured</dt>
                        <dd class="col-sm-8">@(Model.IsFeatured ? "Yes" : "No")</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
