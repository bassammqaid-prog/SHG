@model Al_Shami_ِAISS_.Areas.Admin.ViewModels.ActivityLogDetailViewModel

@{
    ViewData["Title"] = "Activity Log Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Activity Log Details</h1>
            <p class="text-muted mb-0">Review the exact action and metadata stored for this event.</p>
        </div>
        <a asp-area="Admin" asp-controller="ActivityLogs" asp-action="Index" class="btn btn-outline-secondary">Back to Logs</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9">@Model.UserDisplayName</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">@Model.Action</dd>

                <dt class="col-sm-3">Entity</dt>
                <dd class="col-sm-9">@Model.EntityName</dd>

                <dt class="col-sm-3">Entity Id</dt>
                <dd class="col-sm-9">@(Model.EntityId.HasValue ? Model.EntityId.Value.ToString() : "-" )</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">IP Address</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.IpAddress) ? "-" : Model.IpAddress)</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</dd>
            </dl>
        </div>
    </div>
</div>
