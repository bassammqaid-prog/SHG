@model Al_Shami_AISS_.Areas.Admin.ViewModels.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Product Details</h1>
            <p class="text-muted mb-0">Review complete product information.</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">Edit</a>
            <a asp-area="Admin" asp-controller="ProductImages" asp-action="Index" asp-route-productId="@Model.Id" class="btn btn-outline-primary me-2">Manage Images</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-fluid rounded border" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 220px;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.CategoryName</dd>

                        <dt class="col-sm-4">Brand</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Brand) ? "-" : Model.Brand)</dd>

                        <dt class="col-sm-4">Model Number</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ModelNumber) ? "-" : Model.ModelNumber)</dd>

                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

                        <dt class="col-sm-4">Stock</dt>
                        <dd class="col-sm-8">@Model.StockQuantity</dd>

                        <dt class="col-sm-4">Featured</dt>
                        <dd class="col-sm-8">@(Model.IsFeatured ? "Yes" : "No")</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @if (Model.GalleryImages.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Gallery</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var image in Model.GalleryImages)
                    {
                        <div class="col-md-3">
                            <img src="@image" class="img-fluid rounded border" alt="Product gallery image" style="height: 180px; width: 100%; object-fit: cover;" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
