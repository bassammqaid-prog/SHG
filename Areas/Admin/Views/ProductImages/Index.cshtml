@model Al_Shami_AISS_.Areas.Admin.ViewModels.ProductImageListViewModel

@{
    ViewData["Title"] = "Product Gallery";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1">معرض صور المنتجات</h1>
            <p class="text-muted mb-0">إدارة صور المنتجات لـ @Model.ProductName.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary me-2">العودة إلى المنتج</a>
            <a asp-area="Admin" asp-controller="ProductImages" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-primary">إضافة صورة</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model.Images.Any())
    {
        <div class="row g-4">
            @foreach (var image in Model.Images)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card shadow-sm border-0 h-100">
                        <img src="@image.ImageUrl" class="card-img-top" alt="Product gallery image" style="height: 220px; object-fit: cover;" />
                        <div class="card-body text-center">
                            <a asp-area="Admin" asp-controller="ProductImages" asp-action="Delete" asp-route-id="@image.Id" class="btn btn-outline-danger btn-sm">حذف</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">لم يتم تحميل أي صور لهذا المنتج بعد.</div>
    }
</div>
