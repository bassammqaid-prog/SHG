@model Al_Shami_AISS_.Areas.Admin.ViewModels.ProductImageDeleteViewModel

@{
    ViewData["Title"] = "Delete Product Image";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">حذف صورة المنتج</h1>
            <p class="text-muted mb-0">سيؤدي هذا الإجراء إلى إزالة الصورة المحددة من @Model.ProductName.</p>
        </div>
        <a asp-area="Admin" asp-controller="ProductImages" asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-outline-secondary">Back to Gallery</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <img src="@Model.ImageUrl" class="img-fluid rounded border" alt="Image to delete" />
                </div>
                <div class="col-md-7">
                    <p class="mb-3">Are you sure you want to delete this image?</p>

                    <form asp-area="Admin" asp-controller="ProductImages" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">حذف</button>
                        <a asp-area="Admin" asp-controller="ProductImages" asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-outline-secondary ms-2">إلغاء</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
