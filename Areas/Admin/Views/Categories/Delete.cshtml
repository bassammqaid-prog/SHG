@model Al_Shami_ِAISS_.Areas.Admin.ViewModels.CategoryDeleteViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Delete Category</h1>
            <p class="text-muted mb-0">Confirm removal of this category.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-danger">Are you sure you want to delete this category?</h5>
            <p class="card-text">This action will remove: <strong>@Model.Name</strong>.</p>

            <dl class="row mb-3">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">@Model.IsActive</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
