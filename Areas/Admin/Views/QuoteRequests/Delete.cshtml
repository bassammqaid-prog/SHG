@model Al_Shami_AISS_.Areas.Admin.ViewModels.QuoteRequestDeleteViewModel

@{
    ViewData["Title"] = "Delete Quote Request";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">حذف طلب العرض</h1>
            <p class="text-muted mb-0">تاكيد حذف الطلب.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">العودة للقائمة</a>
    </div>

    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-danger">هل أنت متأكد أنك تريد حذف هذا الطلب؟</h5>
            <p class="card-text">سيؤدي هذا الإجراء إلى إزالة الطلب المقدم من <strong>@Model.FullName</strong>.</p>

            <dl class="row mb-3">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">حذف</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">الغاء</a>
            </form>
        </div>
    </div>
</div>
