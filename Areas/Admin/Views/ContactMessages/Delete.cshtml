@model Al_Shami_ِAISS_.Areas.Admin.ViewModels.ContactMessageDeleteViewModel

@{
    ViewData["Title"] = "Delete Contact Message";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Delete Contact Message</h1>
            <p class="text-muted mb-0">Confirm removal of this inquiry.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-danger">Are you sure you want to delete this message?</h5>
            <p class="card-text">This action will remove the message sent by <strong>@Model.FullName</strong>.</p>

            <dl class="row mb-3">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
