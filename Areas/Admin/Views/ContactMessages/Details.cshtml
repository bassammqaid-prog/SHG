@model Al_Shami_ِAISS_.Areas.Admin.ViewModels.ContactMessageDetailsViewModel

@{
    ViewData["Title"] = "Contact Message Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Contact Message Details</h1>
            <p class="text-muted mb-0">Review incoming inquiry details.</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Message</dt>
                <dd class="col-sm-9">@Model.Message</dd>
            </dl>
        </div>
    </div>
</div>
